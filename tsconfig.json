{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source comments are internal notes, not product surface. `files` ships
    // build/, so without this every comment in src/ is published — which is how
    // an internal note about a third party once reached the npm tarball.
    "removeComments": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
